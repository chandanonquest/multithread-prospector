# ==============================================================================
# B2B Prospecting Swarm - Environment Variables Template
# Copy this file to '.env' and populate with your credentials.
# NEVER commit the actual '.env' file to version control.
# ==============================================================================

# Apollo.io API Key (Used for organization enrichment and contact discovery)
# Obtain your key at: https://app.apollo.io/#/settings/api
APOLLO_API_KEY=your_apollo_api_key_here

# Google Workspace / Account Identifier (Optional)
# If multiple Google accounts are connected to gsheets CLI, specify the active one:
# AGY_ACCOUNT=your_email@gmail.com

# Target Prospecting Defaults (Optional)
DEFAULT_TARGET_VERTICAL=B2B SaaS
DEFAULT_BATCH_SIZE=10
